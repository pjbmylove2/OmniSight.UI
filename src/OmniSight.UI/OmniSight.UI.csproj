<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows;net472</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OmniSight.UI</RootNamespace>
    <AssemblyName>OmniSight.UI</AssemblyName>
    <Version>0.4.0</Version>
    <Company>OmniSight</Company>
    <Description>OmniSight WinForms custom UI control library</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
